{
  "name": "nexa-verse-launcher",
  "version": "0.5.25",
  "private": true,
  "description": "Nexa Verse PC launcher official build",
  "repository": {
    "type": "git",
    "url": "https://github.com/NEXARYSE/nexa-verse-launcher.git"
  },
  "main": "electron.cjs",
  "scripts": {
    "start": "electron .",
    "web": "node server.cjs",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.nexaverse.launcher",
  "productName": "NEXAVERSE LAUNCHER",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "**/*",
      "!dist/**",
      "!NEXA VERSE LAUNCHER.exe",
      "!build-social-bridge.cmd",
      "!social_bridge.obj",
      "!README.md",
      "!native/**",
      "!.build-assets/**",
      "!scripts/**",
      "!.pnpm-store/**",
      "!.electron-builder-cache/**",
      "!.electron-cache/**",
      "!.tmp/**"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": ["social-bridge.exe", "discord_partner_sdk.dll", "License-Notices.txt"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "nexa-icon.ico",
      "artifactName": "NEXAVERSE LAUNCHER.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}


